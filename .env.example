# === Backend ===
DATABASE_URL="file:./dev.db"
# Set to true only when you intentionally want to reset the local database on startup.
RESET_DB_ON_START=false
# URL del cliente para CORS (default: http://localhost:5173)
CLIENT_URL=http://localhost:5173

# BaaS externo
EXTERNAL_BAAS_URL=https://core.geozns.com
EXTERNAL_BAAS_API_KEY=your_api_key_here

# JWT
JWT_APP_ID=integrador2_web

# Admin (se crea automaticamente al iniciar)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_strong_password

# Gestor de inventario (se crea automaticamente al iniciar)
INVENTORY_EMAIL=inventory@example.com
INVENTORY_PASSWORD=change_this_to_strong_password

# === Frontend ===
# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Local Docker defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fitactive
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@db:5432/fitactive"
DIRECT_URL="postgresql://postgres:postgres@db:5432/fitactive"
SEED_ON_START=false
CLIENT_URL=http://localhost

# External BaaS used by authentication, email and real-time events
EXTERNAL_BAAS_URL=https://core.geozns.com
EXTERNAL_BAAS_API_KEY=your_api_key_here
JWT_APP_ID=integrador2_web

# Seed credentials are placeholders only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_strong_password
INVENTORY_EMAIL=inventory@example.com
INVENTORY_PASSWORD=change_this_to_strong_password

# Supabase catalog/database configuration
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Frontend build-time configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_BAAS_WS_URL=wss://core.geozns.com/v1/ws
VITE_JWT_APP_ID=integrador2_web

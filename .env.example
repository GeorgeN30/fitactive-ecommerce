# Local Docker defaults
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fitactive
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@db:5432/fitactive"
DIRECT_URL="postgresql://postgres:postgres@db:5432/fitactive"
SEED_ON_START=false
CLIENT_URL=http://localhost

# External BaaS used by authentication, email and real-time events
EXTERNAL_BAAS_URL=https://core.geozns.com
EXTERNAL_BAAS_API_KEY=your_api_key_here
JWT_APP_ID=integrador2_web

# Seed credentials are placeholders only.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_to_strong_password
INVENTORY_EMAIL=inventory@example.com
INVENTORY_PASSWORD=change_this_to_strong_password

# Supabase catalog/database configuration
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"

# Frontend build-time configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_BAAS_WS_URL=wss://core.geozns.com/v1/ws
VITE_JWT_APP_ID=integrador2_web

# Mercado Pago Checkout Pro
# Safe to expose in the frontend bundle; never place private credentials here.
VITE_MP_PUBLIC_KEY=APP_USR-your_test_public_key_here

# Mercado Pago backend-only configuration
# Use test credentials from your Mercado Pago app while testing.
MP_ACCESS_TOKEN=APP_USR-your_test_access_token_here
MP_WEBHOOK_SECRET=your_webhook_signature_secret_here
MP_CURRENCY_ID=PEN
# Optional: only set this when Mercado Pago requires a fixed test buyer email.
MP_TEST_BUYER_EMAIL=
APP_URL=http://localhost
MP_WEBHOOK_URL=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model orden_detalles {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orden_id          String          @db.Uuid
  producto_talla_id String          @db.Uuid
  cantidad          Int
  precio_unitario   Decimal         @db.Decimal(10, 2)
  ordenes           ordenes         @relation(fields: [orden_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_orden")
  producto_tallas   producto_tallas @relation(fields: [producto_talla_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_producto_talla")
}

model ordenes {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String           @db.Uuid
  total          Decimal          @db.Decimal(10, 2)
  estado         String?          @default("PENDIENTE") @db.VarChar(50)
  fecha_orden    DateTime?        @default(now()) @db.Timestamp(6)
  orden_detalles orden_detalles[]
  usuarios       usuarios         @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_usuario")
}

model producto_tallas {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  producto_id    String           @db.Uuid
  talla          String           @db.VarChar(10)
  stock          Int?             @default(0)
  rango_cm_min   Decimal?         @db.Decimal(5, 2)
  rango_cm_max   Decimal?         @db.Decimal(5, 2)
  orden_detalles orden_detalles[]
  productos      productos        @relation(fields: [producto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_producto")
}

model productos {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String            @db.VarChar(150)
  descripcion      String?
  categoria        String?           @db.VarChar(100)
  marca            String?           @db.VarChar(100)
  precio           Decimal           @db.Decimal(10, 2)
  imagen_url       String?
  imagen_avatar_2d String?
  fecha_creacion   DateTime?         @default(now()) @db.Timestamp(6)
  genero           String?
  producto_tallas  producto_tallas[]
}

model usuarios {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String    @unique @db.VarChar(255)

  // Columnas mapeadas al código en inglés
  passwordHash     String?   @map("password_hash") @db.VarChar(255)
  provider         String?   @default("LOCAL") @map("auth_provider") @db.VarChar(50)
  providerId       String?   @unique @map("google_id") @db.VarChar(255)
  role             String?   @default("customer") @map("rol") @db.VarChar(50)

  // Datos biométricos
  medida_pecho     Decimal?  @db.Decimal(5, 2)
  medida_cintura   Decimal?  @db.Decimal(5, 2)
  medida_cadera    Decimal?  @db.Decimal(5, 2)
  fecha_creacion   DateTime? @default(now()) @db.Timestamp(6)

  // Nuevas columnas necesarias para el backend
  name             String?
  picture          String?
  twoFactorEnabled Boolean   @default(false)
  totpSecret       String?
  points           Int       @default(0)

  // Relaciones
  ordenes          ordenes[]
}
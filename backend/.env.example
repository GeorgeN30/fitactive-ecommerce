# Direct backend development only.
# For the full Docker stack, use the root .env.example as the contract.
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitactive"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fitactive"
SEED_ON_START=false

# Shared variables are loaded from the root .env as a fallback by the backend.
# Copy the root .env.example to .env before starting the backend directly.

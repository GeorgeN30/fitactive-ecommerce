# Servidor y Cliente
PORT=4000
CLIENT_URL=http://localhost:5173

# Base de Datos (Producción / Supabase)
DATABASE_URL="postgresql://postgres.TU_USUARIO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.TU_USUARIO:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# API Externa BaaS (Autenticación / OTP)
EXTERNAL_BAAS_URL="https://core.geozns.com"
EXTERNAL_BAAS_API_KEY="your_api_key_here"
JWT_APP_ID="integrador2_web"

# Administrador por defecto
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change_this_to_strong_password"

# Gestor de inventario (opcional o de respaldo)
INVENTORY_EMAIL="inventory@example.com"
INVENTORY_PASSWORD="change_this_to_strong_password"

# Supabase (Credenciales para el catálogo)
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_KEY="your_supabase_anon_key_here"
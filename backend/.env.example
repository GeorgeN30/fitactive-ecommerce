# Direct backend development only.
PORT=4000
CLIENT_URL=http://localhost:5173
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fitactive"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fitactive"
SEED_ON_START=false

# Shared variables are loaded from the root .env as a fallback.

# Mercado Pago Checkout Pro (backend only)
# Use test credentials while validating the payment flow.
MP_ACCESS_TOKEN=APP_USR-your_test_access_token_here
MP_WEBHOOK_SECRET=your_webhook_signature_secret_here
MP_CURRENCY_ID=PEN
MP_TEST_BUYER_EMAIL=
APP_URL=http://localhost
MP_WEBHOOK_URL=
